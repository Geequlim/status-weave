{
	"compilerOptions": {
		"target": "ES2020",
		"module": "Node16",
		"moduleResolution": "Node16",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"rootDir": "src",
		"outDir": "build",
		"declaration": true,
		"sourceMap": true,
		"noEmitOnError": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["build", "node_modules"]
}
